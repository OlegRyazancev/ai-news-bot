# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Database Configuration
DB_USER=botuser
DB_PASSWORD=botpass
DB_NAME=ai_news_bot
DATABASE_URL=postgresql://botuser:botpass@localhost:5432/ai_news_bot?schema=public

# Application Configuration
NODE_ENV=development
LOG_LEVEL=debug

# News Collection Configuration
# Every 30 minutes by default
NEWS_COLLECTION_CRON=*/30 * * * *
NEWS_COLLECTION_RUN_ON_STARTUP=true
NEWS_FETCH_TIMEOUT_MS=15000
NEWS_MAX_ITEMS_PER_SOURCE=50
