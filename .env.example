# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# Database Configuration
DB_USER=botuser
DB_PASSWORD=botpass
DB_NAME=ai_news_bot
DATABASE_URL=postgresql://botuser:botpass@localhost:5432/ai_news_bot?schema=public

# Application Configuration
NODE_ENV=development
LOG_LEVEL=debug

# News Collection Configuration
# Every 30 minutes by default
NEWS_COLLECTION_CRON=*/30 * * * *
NEWS_COLLECTION_RUN_ON_STARTUP=true
NEWS_FETCH_TIMEOUT_MS=15000
NEWS_MAX_ITEMS_PER_SOURCE=50

# LLM Processing Configuration
# Keep disabled until the database schema is updated and a provider is configured.
LLM_PROCESSING_ENABLED=false
# mock is safe for development/tests; use gemini for the real provider.
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash-lite
# Required only when LLM_PROCESSING_ENABLED=true and LLM_PROVIDER=gemini.
GEMINI_API_KEY=
# Independent processor schedule (every 2 minutes by default).
LLM_PROCESSING_CRON=*/2 * * * *
LLM_PROCESSING_RUN_ON_STARTUP=true
LLM_PROCESSING_BATCH_SIZE=5
# Internal provider-wide safety budget per UTC day (not the Google quota).
LLM_DAILY_REQUEST_LIMIT=20
LLM_REQUEST_TIMEOUT_MS=30000
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=60000
LLM_RETRY_MAX_DELAY_MS=21600000
LLM_STALE_PROCESSING_MS=600000
